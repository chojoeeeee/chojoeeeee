# DEMO_MODE=true 이면 키/승인이 없는 서비스가 'DEMO DATA'로 채워집니다. 운영에서는 false.
DEMO_MODE=true

# ---- Provider modes: mock | live -------------------------------------------
# API 키가 없으면 해당 Provider는 자동으로 DEMO(mock) 데이터로 동작합니다.
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=KR
SKYSCANNER_LOCALE=ko-KR

# Trip.com Flight API: 파트너 협약 후 발급되는 appKey/appSecret (developers.trip.com/flight).
# 승인 전에는 mock 고정. (live여도 Shopping 매퍼 구현 전까지는 동작하지 않음)
TRIP_PROVIDER_MODE=mock
TRIP_APP_KEY=
TRIP_APP_SECRET=

# 알리항공권: 공급원 Fliggy의 공식 FlyAI CLI(npm i -g @fly-ai/flyai-cli)를 쓰려면 옵트인.
# 가격은 CNY이므로 환율(원/위안)을 반드시 직접 지정해야 함.
ALI_PROVIDER_MODE=
FLYAI_CLI_PATH=flyai
FX_CNY_KRW=

# ---- Search engine ---------------------------------------------------------
PROVIDER_TIMEOUT_MS=8000
SEARCH_CACHE_TTL_SECONDS=900

# ---- 공개 웹 특가 수집 (캐치프로그 / 출국의 신) ------------------------------
# 이용약관과 robots.txt를 직접 확인하고 허용되는 경우에만 yes. 기본값(비어 있음) = 수집 안 함.
# 백그라운드(스케줄러) 수집은 별도 승인입니다. Skyscanner Live API는 어떤 설정으로도 백그라운드 호출이 막혀 있습니다.
CATCHFROG_COLLECTION_APPROVED=
CATCHFROG_BACKGROUND_APPROVED=
GODFLIGHT_COLLECTION_APPROVED=
GODFLIGHT_BACKGROUND_APPROVED=

# ---- Phase 2: 저장소 / 알림 / 스케줄러 ------------------------------------------
# Supabase Postgres 연결 문자열(Pooler 권장). 비어 있으면 임시 메모리 저장소를 씁니다(재시작 시 초기화).
# 테이블 생성: DATABASE_URL을 설정하고 `npm run db:migrate`, 또는 drizzle/*.sql을 Supabase SQL Editor에서 순서대로 실행.
DATABASE_URL=
OWNER_USER_ID=

# Telegram: @BotFather로 봇을 만들어 토큰을 받고, 봇과 대화를 시작한 뒤 chat id를 확인합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true면 실제로 보내지 않고 서버 로그에만 메시지를 출력합니다 (테스트/개발용).
TELEGRAM_DRY_RUN=

# /api/cron/watchlists 호출 인증 (Authorization: Bearer <CRON_SECRET>). 비어 있으면 항상 401.
CRON_SECRET=

WATCHLIST_PROVIDER_TIMEOUT_MS=15000
# 같은 Watchlist의 '다시 확인' 최소 간격(초). Live API 호출 남용 방지.
USER_REFRESH_MIN_SECONDS=60

# /admin 접근 비밀번호 (HTTP Basic, 사용자명은 아무거나). 운영에서 비어 있으면 /admin은 404.
ADMIN_PASSWORD=

# ---- 실제 사용 모드 (Vercel 배포용 요약) -----------------------------------------
# 필수: DATABASE_URL(Supabase Pooler URL), ADMIN_PASSWORD, CRON_SECRET
# 선택: SKYSCANNER_API_KEY(있으면 LIVE, 없으면 "자동 조회 준비 중"), TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# DEMO_MODE=true 이면 모든 가격·알림에 [테스트] 표시가 붙고 실제 데이터와 섞이지 않습니다.
# DEMO_PRICE_OFFSET: DEMO 요금에 더할 금액(원, 음수 가능). 가격 하락 시나리오를 재현할 때만 사용.
DEMO_PRICE_OFFSET=
