# DEMO_MODE=true 이면 키/승인이 없는 서비스가 'DEMO DATA'로 채워집니다. 운영에서는 false.
DEMO_MODE=true

# ---- Provider modes: mock | live -------------------------------------------
# API 키가 없으면 해당 Provider는 자동으로 DEMO(mock) 데이터로 동작합니다.
SKYSCANNER_API_KEY=
SKYSCANNER_MARKET=KR
SKYSCANNER_LOCALE=ko-KR

# Trip.com Flight API: 파트너 협약 후 발급되는 appKey/appSecret (developers.trip.com/flight).
# 승인 전에는 mock 고정. (live여도 Shopping 매퍼 구현 전까지는 동작하지 않음)
TRIP_PROVIDER_MODE=mock
TRIP_APP_KEY=
TRIP_APP_SECRET=

# 알리항공권: 공급원 Fliggy의 공식 FlyAI CLI(npm i -g @fly-ai/flyai-cli)를 쓰려면 옵트인.
# 가격은 CNY이므로 환율(원/위안)을 반드시 직접 지정해야 함.
ALI_PROVIDER_MODE=
FLYAI_CLI_PATH=flyai
FX_CNY_KRW=

# ---- Search engine ---------------------------------------------------------
PROVIDER_TIMEOUT_MS=8000
SEARCH_CACHE_TTL_SECONDS=900

# ---- Phase 2 (Telegram / Supabase) -----------------------------------------
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
CRON_SECRET=

# ---- 공개 웹 특가 수집 (캐치프로그 / 출국의 신) ------------------------------
# 이용약관과 robots.txt를 직접 확인하고 허용되는 경우에만 yes. 기본값(비어 있음) = 수집 안 함.
# 백그라운드(스케줄러) 수집은 별도 승인입니다. Skyscanner Live API는 어떤 설정으로도 백그라운드 호출이 막혀 있습니다.
CATCHFROG_COLLECTION_APPROVED=
CATCHFROG_BACKGROUND_APPROVED=
GODFLIGHT_COLLECTION_APPROVED=
GODFLIGHT_BACKGROUND_APPROVED=
